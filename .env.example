# IT Device Manager local configuration
# Copy this file to .env and fill in your own values.
# Never commit or share the real .env file because it can contain secrets.

# Optional: override the default SQL Server connection string.
# ITDM_CONNECTION_STRING=Server=CANHTHIEN;Database=ITDeviceManagerDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True

ITDM_SMTP_HOST=smtp.gmail.com
ITDM_SMTP_PORT=587
ITDM_SMTP_USERNAME=your-email@gmail.com
ITDM_SMTP_PASSWORD=your-gmail-app-password
ITDM_SMTP_FROM_EMAIL=your-email@gmail.com
ITDM_SMTP_FROM_NAME=IT Device Manager
ITDM_SMTP_SSL_ON_CONNECT=false

# Optional: HTTPS bridge used by password-reset emails before opening the custom app URI.
# ITDM_PASSWORD_RESET_WEB_URL=https://tamnhien.github.io/ITDeviceManager/reset-password.html

# Optional: keep SQL Server MDF/LDF inside the project workspace.
# ITDM_DATABASE_FILES_DIRECTORY=D:\LienThongDH\Lap_trinh_tren_moi_truong_window_A01\ITDeviceManager\DatabaseFiles

# Optional: preferred folder for .bak files created from the application.
# ITDM_BACKUP_DIRECTORY=D:\LienThongDH\Lap_trinh_tren_moi_truong_window_A01\ITDeviceManager\Backups
# V2.0.0: generated QR and Code 128 PNG files. If omitted, the app uses <project root>\QR.
# ITDM_QR_DIRECTORY=D:\LienThongDH\Lap_trinh_tren_moi_truong_window_A01\ITDeviceManager\QR

