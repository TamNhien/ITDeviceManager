# Keep text deterministic and avoid release-time line-ending warnings.
# Windows-oriented source/scripts use CRLF; documentation/config/SQL stay LF.
.gitattributes text eol=lf
.gitignore text eol=lf
.env.example text eol=lf
VERSION.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf

*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf

*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.mdf binary
*.ldf binary
*.bak binary
